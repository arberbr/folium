NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/today
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/today

# Turso/libSQL. Leave empty to fall back to a local file at ./data/local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local databases migrate on boot. Set to 1 to also migrate a remote one on boot
# instead of running `pnpm db:migrate` from your release step.
DB_AUTO_MIGRATE=